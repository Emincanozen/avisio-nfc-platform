// Modèle de données Avisio — PostgreSQL.
//
// Souveraineté : l'instance de production est hébergée en France (OVHcloud
// Gravelines ou AWS eu-west-3). Aucun avis ni contact ne sort de l'UE.
//
// Minimisation RGPD : ni le programme de fidélité ni l'intégration caisse ne
// stockent de coordonnées en clair — seulement un condensat.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  essentiel
  pro
  premium
}

enum Addon {
  negative_reviews
  extra_platform
  analytics
  loyalty
}

enum Platform {
  google
  tripadvisor
  facebook
  yelp
  thefork
}

enum Sector {
  restaurant
  bar
  hotel
  retail
  beauty
  health
  other
}

enum ReviewStatus {
  new
  draft_ready
  answered
  ignored
}

enum AlertType {
  negative_review
  theme_trend
  rating_drop
}

enum AlertSeverity {
  info
  warning
  critical
}

enum TagMaterial {
  sticker
  chevalet
  premium
}

enum LoyaltyChannel {
  sms
  email
}

enum ManagerRole {
  owner
  admin
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  canceled
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
}

model Manager {
  id             String          @id
  email          String          @unique
  passwordHash   String
  name           String
  role           ManagerRole     @default(owner)
  createdAt      DateTime        @default(now())
  establishments Establishment[] @relation("ManagerEstablishments")
  pushSubscriptions PushSubscription[]

  @@map("managers")
}

model Establishment {
  id                String   @id
  name              String
  sector            Sector
  postalCode        String
  nafCode           String?
  plan              Plan     @default(essentiel)
  addons            Addon[]  @default([])
  committed12Months Boolean  @default(false)
  brandTone         String   @default("professionnel et courtois")
  defaultLocale     String   @default("fr")
  createdAt         DateTime @default(now())

  managers       Manager[]       @relation("ManagerEstablishments")
  platformLinks  PlatformLink[]
  tags           NfcTag[]
  scans          ScanEvent[]
  reviews        Review[]
  alerts         Alert[]
  loyaltyMembers LoyaltyMember[]
  subscription   Subscription?
  invoices       Invoice[]
  notificationPreference NotificationPreference?
  posTickets     PosTicket[]

  // Le benchmark interroge (secteur, code postal) sur toute la base.
  @@index([sector, postalCode])
  @@index([nafCode, postalCode])
  @@map("establishments")
}

model PlatformLink {
  id              String    @id @default(uuid())
  establishmentId String
  platform        Platform
  reviewUrl       String
  externalId      String?
  enabled         Boolean   @default(true)
  reviewCount     Int       @default(0)
  routedScans     Int       @default(0)
  averageRating   Float?
  lastSyncedAt    DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, platform])
  @@map("platform_links")
}

model NfcTag {
  id              String      @id
  establishmentId String
  label           String
  slug            String      @unique
  material        TagMaterial @default(sticker)
  scanCount       Int         @default(0)
  lastScanAt      DateTime?
  createdAt       DateTime    @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  scans         ScanEvent[]

  @@index([establishmentId])
  @@map("nfc_tags")
}

model ScanEvent {
  id              String   @id
  tagId           String
  establishmentId String
  platform        Platform
  locale          String   @default("fr")
  userAgent       String?
  createdAt       DateTime @default(now())

  tag           NfcTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, createdAt])
  @@map("scan_events")
}

model Review {
  id              String       @id
  establishmentId String
  platform        Platform
  externalId      String
  author          String
  rating          Int
  comment         String
  publishedAt     DateTime
  ingestedAt      DateTime     @default(now())
  status          ReviewStatus @default(new)
  replyText       String?
  repliedAt       DateTime?

  // Résultat du pipeline NLP, dénormalisé pour éviter une jointure sur le
  // chemin chaud du dashboard.
  sentiment      String?
  sentimentScore Float?
  themes         String[] @default([])
  keywords       String[] @default([])
  language       String?
  analysisEngine String?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  alerts        Alert[]

  // Idempotence de l'ingestion : un avis de plateforme n'entre qu'une fois.
  @@unique([establishmentId, platform, externalId])
  @@index([establishmentId, publishedAt])
  @@index([establishmentId, status])
  @@map("reviews")
}

model Alert {
  id              String        @id
  establishmentId String
  type            AlertType
  severity        AlertSeverity @default(info)
  title           String
  body            String
  reviewId        String?
  createdAt       DateTime      @default(now())
  readAt          DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  review        Review?       @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([establishmentId, createdAt])
  @@map("alerts")
}

model LoyaltyMember {
  id              String         @id
  establishmentId String
  contactHash     String
  channel         LoyaltyChannel
  points          Int            @default(0)
  createdAt       DateTime       @default(now())
  lastEarnedAt    DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, contactHash])
  @@map("loyalty_members")
}

// ---------------------------------------------------------------------------
// Facturation
// ---------------------------------------------------------------------------

model Subscription {
  id                 String             @id
  establishmentId    String             @unique
  plan               Plan
  addons             Addon[]            @default([])
  extraPlatforms     Int                @default(0)
  tags               Int                @default(1)
  committed12Months  Boolean            @default(false)
  status             SubscriptionStatus @default(active)
  startedAt          DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAt           DateTime?
  canceledAt         DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  // La facturation balaie les abonnements dont la période est échue.
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id               String        @id
  // Numérotation légale : continue, sans rupture, une séquence par année.
  number           String        @unique
  establishmentId  String
  subscriptionId   String
  status           InvoiceStatus @default(open)
  periodStart      DateTime
  periodEnd        DateTime
  issuedAt         DateTime      @default(now())
  dueAt            DateTime
  paidAt           DateTime?
  lines            Json
  subtotalCents    Int
  vatCents         Int
  totalCents       Int
  paymentReference String?
  remindersSent    Int           @default(0)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  subscription  Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([establishmentId, issuedAt])
  @@index([status, dueAt])
  @@map("invoices")
}

/**
 * Compteur de numérotation, une ligne par année.
 * Incrémenté dans la même transaction que la création de la facture : c'est ce
 * qui garantit l'absence de trou dans la séquence.
 */
model InvoiceCounter {
  year     Int @id
  sequence Int @default(0)

  @@map("invoice_counters")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id
  managerId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([managerId])
  @@map("push_subscriptions")
}

model NotificationPreference {
  establishmentId String  @id
  // { "negative_review": ["email","push"], … }
  channels        Json
  quietHoursStart Int?
  quietHoursEnd   Int?
  utcOffsetHours  Int     @default(2)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/** File des push différés par les heures calmes. */
model PendingPush {
  id        String   @id
  managerId String
  title     String
  body      String
  url       String?
  sendAt    DateTime
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([sentAt, sendAt])
  @@map("pending_pushes")
}

// ---------------------------------------------------------------------------
// Intégration caisse
// ---------------------------------------------------------------------------

model PosTicket {
  id              String    @id
  establishmentId String
  externalId      String
  closedAt        DateTime
  totalCents      Int
  // Condensat du contact : jamais l'e-mail ni le téléphone en clair.
  contactHash     String?
  contactChannel  String?
  reference       String?
  invitedAt       DateTime?
  createdAt       DateTime  @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  // Idempotence : une caisse qui rejoue un ticket ne le duplique pas.
  @@unique([establishmentId, externalId])
  @@index([establishmentId, closedAt])
  @@map("pos_tickets")
}

/** Clé d'API d'une caisse, pour signer ses appels webhook. */
model PosCredential {
  establishmentId String   @id
  vendor          String   @default("generic")
  // Condensat de la clé : elle n'est montrée qu'une fois, à la création.
  secretHash      String
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  @@map("pos_credentials")
}
