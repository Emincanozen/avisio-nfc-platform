# ---------------------------------------------------------------------------
# Avisio — Environment Variables
# Copy to .env at root. No value is required for demo mode:
# without DATABASE_URL, the API starts with the in-memory adapter and demo data.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Persistence. Empty => in-memory adapter (demo mode, data resets on reboot)
DATABASE_URL="postgresql://avisio:YOUR_PASSWORD_HERE@localhost:5433/avisio"

# JWT signing secret for manager portal sessions (32+ characters in production)
JWT_SECRET="You can put your API key here"

# Anthropic — reply suggestions + NLP. Empty => local heuristic engine.
ANTHROPIC_API_KEY="You can put your API key here"
ANTHROPIC_MODEL=claude-opus-5

# Google Business Profile — see docs/google.md for full procedure.
#
# Consent is granted PER ESTABLISHMENT: the business listing owner
# authorizes Avisio on THEIR listing. There is no single token covering the entire fleet;
# no one can consent on behalf of another entity.
#
# Empty => simulated connector, and UI offers manual CSV import.
GOOGLE_CLIENT_ID="You can put your API key here"
GOOGLE_CLIENT_SECRET="You can put your API key here"
# Must match EXACTLY the URI registered in the Google Cloud Console.
# Empty => <PUBLIC_API_URL>/integrations/google/callback
GOOGLE_REDIRECT_URI=
# Legacy single-establishment fallback. Leave empty for multi-establishment deployments.
GOOGLE_REFRESH_TOKEN="You can put your API key here"

# Transactional email (Resend). Empty => emails logged to console.
RESEND_API_KEY="You can put your API key here"
MAIL_FROM=alertes@avisio.fr

# Review ingestion interval (minutes)
INGEST_INTERVAL_MINUTES=20

# Push notifications (Web Push / VAPID). Empty => push events logged to console.
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="You can put your API key here"
VAPID_PRIVATE_KEY="You can put your API key here"

# Legal notices displayed on invoices.
#
# Values below are EXAMPLES; production startup is REFUSED
# as long as SIRET and VAT numbers remain default examples.
# Every missing mandatory notice is penalized under trade regulations.
COMPANY_NAME=Avisio SAS
COMPANY_ADDRESS=12 rue des Minimes, 31200 Toulouse
COMPANY_SIRET=000 000 000 00000
COMPANY_VAT=FR00000000000
COMPANY_IBAN=

# Billing and payment reminder cycle frequency (hours)
BILLING_INTERVAL_HOURS=6

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Encryption key for database-stored secrets (customer OAuth tokens).
# Empty => derived from JWT_SECRET. SEPARATE in production: rotating
# session secrets must not invalidate stored Google tokens.
# Changing it requires each client to re-authenticate their listing.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRETS_KEY="You can put your API key here"

# Trust level granted to X-Forwarded-For headers. Default: none (untrusted).
#
# Client IP is the key used for all rate limiting. Trusting headers blindly
# without a trusted proxy in front allows spoofing IP addresses and bypassing rate limits.
#
# Behind a reverse proxy: set the NUMBER of trusted hops (e.g. TRUST_PROXY=1).
# Hop counts avoid breaking when hosting providers change IP subnets.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Spend Guardrails
# ---------------------------------------------------------------------------

# Ceiling on language model API calls per hour per process.
# Exceeding this throttles to local heuristic engine without failing user requests.
# Monitor `llm.throttled` in /admin/overview: zero is normal operation;
# if elevated, either usage is spiking or the limit needs tuning.
LLM_MAX_CALLS_PER_HOUR=500

# Language model call timeout (ms). Beyond this, fallback to local heuristics.
LLM_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Demonstration Mode
# ---------------------------------------------------------------------------

# Enables simulated connectors that GENERATE reviews.
#
# Leave empty everywhere except commercial demo environments.
# Without this setting, unconnected platforms remain silent — reflecting reality —
# rather than populating dashboards with synthetic reviews.
#
# Synthetic reviews carry `source: 'demo'` in DB and are excluded from metrics.
# Configuration guard REFUSES startup if this setting is enabled with NODE_ENV=production.
AVISIO_DEMO_MODE=
