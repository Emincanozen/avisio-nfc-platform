# ---------------------------------------------------------------------------
# Avisio — variables d'environnement
# Copier en .env à la racine. Aucune valeur n'est obligatoire pour la démo :
# sans DATABASE_URL, l'API démarre sur l'adaptateur mémoire avec jeu de démo.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Persistance. Vide => adaptateur mémoire (démo, données réinitialisées au boot)
DATABASE_URL=

# Secret de signature des JWT de l'espace gérant (32+ caractères en production)
JWT_SECRET=dev-secret-change-me-in-production-0123456789

# Anthropic — suggestions de réponse + NLP. Vide => moteur heuristique local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Google Business Profile — ingestion des avis. Vide => connecteur simulé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Email transactionnel (Resend). Vide => les emails sont journalisés en console.
RESEND_API_KEY=
MAIL_FROM=alertes@avisio.fr

# Cadence d'ingestion des avis (minutes)
INGEST_INTERVAL_MINUTES=20

# Notifications push (Web Push / VAPID). Vide => push journalisés en console.
# Générer un jeu de clés : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mentions légales portées par les factures
COMPANY_NAME=Avisio SAS
COMPANY_ADDRESS=12 rue des Minimes, 31200 Toulouse
COMPANY_SIRET=000 000 000 00000
COMPANY_VAT=FR00000000000
COMPANY_IBAN=

# Cadence du cycle de facturation et des relances (heures)
BILLING_INTERVAL_HOURS=6
