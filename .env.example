# ---------------------------------------------------------------------------
# Avisio — variables d'environnement
# Copier en .env à la racine. Aucune valeur n'est obligatoire pour la démo :
# sans DATABASE_URL, l'API démarre sur l'adaptateur mémoire avec jeu de démo.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Persistance. Vide => adaptateur mémoire (démo, données réinitialisées au boot)
DATABASE_URL=

# Secret de signature des JWT de l'espace gérant (32+ caractères en production)
JWT_SECRET=dev-secret-change-me-in-production-0123456789

# Anthropic — suggestions de réponse + NLP. Vide => moteur heuristique local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Google Business Profile — voir docs/google.md pour la procedure complete.
#
# Le consentement se fait PAR ETABLISSEMENT : le proprietaire de la fiche
# autorise Avisio sur SA fiche. Il n'existe pas de jeton couvrant tout le parc,
# personne ne peut consentir a la place d'un autre.
#
# Vide => connecteur simule, et l'interface propose l'import manuel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit correspondre AU CARACTERE PRES a l'URI declaree dans la console Google.
# Vide => <PUBLIC_API_URL>/integrations/google/callback
GOOGLE_REDIRECT_URI=
# Repli mono-etablissement herite. Laisser vide en multi-etablissements.
GOOGLE_REFRESH_TOKEN=

# Email transactionnel (Resend). Vide => les emails sont journalisés en console.
RESEND_API_KEY=
MAIL_FROM=alertes@avisio.fr

# Cadence d'ingestion des avis (minutes)
INGEST_INTERVAL_MINUTES=20

# Notifications push (Web Push / VAPID). Vide => push journalisés en console.
# Générer un jeu de clés : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mentions légales portées par les factures
COMPANY_NAME=Avisio SAS
COMPANY_ADDRESS=12 rue des Minimes, 31200 Toulouse
COMPANY_SIRET=000 000 000 00000
COMPANY_VAT=FR00000000000
COMPANY_IBAN=

# Cadence du cycle de facturation et des relances (heures)
BILLING_INTERVAL_HOURS=6

# ---------------------------------------------------------------------------
# Securite
# ---------------------------------------------------------------------------

# Scellement des secrets stockes en base (jetons OAuth des clients).
# Vide => derivee de JWT_SECRET. A SEPARER en production : faire tourner le
# secret des sessions ne doit pas rendre illisibles tous les jetons Google.
# La changer oblige chaque client a reautoriser sa fiche.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRETS_KEY=

# Confiance accordee a X-Forwarded-For. Par defaut : aucune.
#
# C'est l'IP qui sert de cle a toute la limitation de debit. La croire sur
# parole sans proxy devant revient a offrir une identite neuve a chaque
# requete, donc a annuler tous les budgets.
#
# Derriere un reverse proxy : le NOMBRE de sauts de confiance (TRUST_PROXY=1).
# Le nombre est preferable a une liste d'adresses : il ne se perime pas quand
# l'hebergeur change ses plages.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Garde-fous de depense
# ---------------------------------------------------------------------------

# Plafond d'appels au modele de langage, par heure et par processus. Le
# depassement bascule sur le moteur heuristique local, il ne fait echouer
# personne. Surveiller `llm.throttled` dans /admin/overview : a zero, c'est le
# cas normal ; s'il monte, soit quelque chose s'emballe, soit le plafond est
# trop bas pour l'usage reel.
LLM_MAX_CALLS_PER_HOUR=500

# Delai de garde d'un appel au modele. Au-dela, repli local : un appel qui ne
# revient jamais bloquerait tout le cycle d'ingestion.
LLM_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Mode demonstration
# ---------------------------------------------------------------------------

# Autorise les connecteurs simules, qui FABRIQUENT des avis.
#
# A laisser vide partout ailleurs qu'en demonstration commerciale. Sans lui,
# une plateforme non connectee reste muette — ce qui est la verite — au lieu
# de remplir le tableau de bord du client d'avis qui n'existent pas.
#
# Les avis fabriques portent source: 'demo' jusqu'en base et sont exclus de
# toute metrique. Le controle de configuration REFUSE le demarrage si ce
# reglage est actif avec NODE_ENV=production.
AVISIO_DEMO_MODE=
